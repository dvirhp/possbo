# Runtime
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:4200
RUN_SCHEDULER=true

# PostgreSQL (use separate credentials and databases per environment)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/possbo?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/possbo?sslmode=require
REDIS_URL=

# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
SESSION_SECRET=replace-with-another-32-random-characters
ENCRYPTION_KEY=replace-with-another-32-random-characters

# Publishing worker
PUBLICATION_CLAIM_LIMIT=10
PUBLICATION_USER_CONCURRENCY=10
DAILY_PUBLISH_LIMIT=70
PUBLISH_TIMEZONE=Asia/Jerusalem
PUBLICATION_JOB_HEARTBEAT_MS=30000
USER_PUBLISH_LOCK_LEASE_MS=300000
USER_PUBLISH_LOCK_HEARTBEAT_MS=30000
FB_AUTOMATION_HEADLESS=true
WORKER_MEMORY_LIMIT_MB=1024
WORKER_RESERVED_MEMORY_MB=256
CHROMIUM_MEMORY_MB=350
CHROMIUM_CONCURRENCY=
PROXY_URL=

# Public media URL. Production uploads will move to S3-compatible object storage.
MEDIA_PUBLIC_URL=http://localhost:8000

# Durable media (AWS S3, Cloudflare R2, MinIO, or another S3-compatible service)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Billing. Leave both empty until Stripe is connected; checkout then fails closed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional development-only fallback image hosts (never commit their keys)
FREEIMAGE_API_KEY=
IMGUR_CLIENT_ID=

# AI
GEMINI_API_KEY=

# Authentication and OAuth
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/api/auth/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# WhatsApp Cloud bot
WA_BOT_PHONE_NUMBER_ID=
WA_BOT_ACCESS_TOKEN=
WA_BOT_VERIFY_TOKEN=
WA_BOT_PUBLIC_URL=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=

# Security, logging and operations
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ADMIN_EMAILS=
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
PUBLICATION_HISTORY_RETENTION_DAYS=365
PUBLICATION_METRIC_RETENTION_DAYS=180
COMPLETED_JOB_RETENTION_DAYS=90
ALERT_FAILED_JOBS_PER_HOUR=5
ALERT_QUEUE_DEPTH=1000
ALERT_WEBHOOK_URL=
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@possbo.com

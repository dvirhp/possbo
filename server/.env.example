DATABASE_URL="file:./dev.db"
PORT=5000
SESSION_SECRET=your_session_secret_here
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_32_chars_min
JWT_REFRESH_SECRET=your_refresh_secret_32_chars_min
ENCRYPTION_KEY=your_encryption_key_32_chars_min

# Instagram OAuth
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/instagram/callback

# Public URL for media files (required for Instagram publishing in production)
# Instagram API needs to fetch your images — must be publicly accessible
MEDIA_PUBLIC_URL=https://your-production-domain.com

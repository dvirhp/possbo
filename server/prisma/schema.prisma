generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                   @id @default(uuid())
  email                String?                  @unique
  username             String?                  @unique
  passwordHash         String?                  @map("password_hash")
  name                 String?
  firstName            String?                  @map("first_name")
  lastName             String?                  @map("last_name")
  phone                String?
  profilePicture       String?                  @map("profile_picture_url")
  profileImage         String?                  @map("profile_image")
  facebookId           String?                  @unique @map("facebook_id")
  facebookAccessToken  String?                  @map("facebook_access_token")
  status               UserStatus               @default(ACTIVE)
  emailVerifiedAt      DateTime?                @map("email_verified_at")
  lastLoginAt          DateTime?                @map("last_login_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  facebookAppId        String?                  @map("facebook_app_id")
  facebookAppSecret    String?                  @map("facebook_app_secret")
  refreshToken         String?                  @map("refresh_token")
  facebookStorageState String?                  @map("facebook_storage_state")
  gender               String?
  auditLogs            AuditLog[]
  connectedAccounts    ConnectedAccount[]
  emailVerifications   EmailVerificationToken[]
  facebookGroups       FacebookGroup[]
  groupSyncs           GroupSyncHistory[]
  notifications        Notification[]
  passwordResets       PasswordResetToken[]
  postGroups           PostGroup[]
  templates            PostTemplate[]
  posts                Post[]
  publications         PublicationHistory[]
  subscriptions        Subscription[]
  usageLimits          UsageLimit[]
  userGroups           UserGroup[]
  sessions             UserSession[]

  @@map("users")
}

model FacebookGroup {
  id         String   @id @default(uuid())
  screenshot String?
  createdAt  DateTime @default(now()) @map("created_at")
  groupId    String   @map("group_id")
  groupImage String?  @map("group_image")
  groupName  String   @map("group_name")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("facebook_groups")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model ConnectedAccount {
  id                    String                   @id @default(uuid())
  userId                String                   @map("user_id")
  provider              ConnectedAccountProvider
  providerUserId        String                   @map("provider_user_id")
  providerUserName      String?                  @map("provider_user_name")
  accessTokenEncrypted  String                   @map("access_token_encrypted")
  refreshTokenEncrypted String?                  @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?                @map("token_expires_at")
  storageStatePath      String?                  @map("storage_state_path")
  status                ConnectedAccountStatus   @default(ACTIVE)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSyncs            GroupSyncHistory[]
  userGroups            UserGroup[]

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("connected_accounts")
}

model Group {
  id              String               @id @default(uuid())
  externalGroupId String?              @unique @map("external_group_id")
  name            String
  pictureUrl      String?              @map("picture_url")
  url             String?
  privacyType     String?              @map("privacy_type")
  memberCount     Int?                 @map("member_count")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  postGroups      PostGroup[]
  publications    PublicationHistory[]
  userGroups      UserGroup[]

  @@map("groups")
}

model UserGroup {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  groupId            String            @map("group_id")
  connectedAccountId String?           @map("connected_account_id")
  role               String?
  canPost            Boolean           @default(true) @map("can_post")
  joinedAt           DateTime?         @map("joined_at")
  lastSyncedAt       DateTime?         @map("last_synced_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])
  group              Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_groups")
}

model Post {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  title           String?
  content         String
  status          PostStatus           @default(DRAFT)
  isAnonymous     Boolean              @default(false) @map("is_anonymous")
  location        String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  campaignType   CampaignType         @default(ONE_TIME) @map("campaign_type")
  recurringDays  Int[]                @default([]) @map("recurring_days")
  scheduledDates DateTime[]           @default([]) @map("scheduled_dates")
  recurringTime  String?              @map("recurring_time")
  isPaused       Boolean              @default(false) @map("is_paused")
  imageUrl       String?              @map("image_url")
  postGroups      PostGroup[]
  media           PostMedia[]
  templates       PostTemplate[]
  versions        PostVersion[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications    PublicationHistory[]

  @@index([userId])
  @@index([status])
  @@map("posts")
}

model PostMedia {
  id         String    @id @default(uuid())
  postId     String    @map("post_id")
  mediaType  MediaType @map("media_type")
  url        String
  storageKey String?   @map("storage_key")
  orderIndex Int       @default(0) @map("order_index")
  altText    String?   @map("alt_text")
  createdAt  DateTime  @default(now()) @map("created_at")
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostGroup {
  id              String               @id @default(uuid())
  postId          String               @map("post_id")
  groupId         String               @map("group_id")
  userId          String               @map("user_id")
  isEnabled       Boolean              @default(true) @map("is_enabled")
  priorityEnabled Boolean              @default(false) @map("priority_enabled")
  priorityRank    Int?                 @map("priority_rank")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  schedules       PostGroupSchedule[]
  group           Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post            Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications    PublicationHistory[]
  jobs            PublicationJob[]

  @@unique([postId, groupId])
  @@index([userId])
  @@map("post_groups")
}

model PostGroupSchedule {
  id            String        @id @default(uuid())
  postGroupId   String        @map("post_group_id")
  frequencyType FrequencyType @map("frequency_type")
  intervalValue Int?          @map("interval_value")
  intervalUnit  IntervalUnit? @map("interval_unit")
  startAt       DateTime?     @map("start_at")
  endAt         DateTime?     @map("end_at")
  nextRunAt     DateTime?     @map("next_run_at")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  postGroup     PostGroup     @relation(fields: [postGroupId], references: [id], onDelete: Cascade)

  @@index([postGroupId])
  @@index([nextRunAt, isActive])
  @@map("post_group_schedules")
}

model PublicationJob {
  id           String               @id @default(uuid())
  postGroupId  String               @map("post_group_id")
  scheduledAt  DateTime             @map("scheduled_at")
  startedAt    DateTime?            @map("started_at")
  completedAt  DateTime?            @map("completed_at")
  status       JobStatus            @default(PENDING)
  attempts     Int                  @default(0)
  maxAttempts  Int                  @default(3) @map("max_attempts")
  lastError    String?              @map("last_error")
  lockedAt     DateTime?            @map("locked_at")
  lockedBy     String?              @map("locked_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  publications PublicationHistory[]
  postGroup    PostGroup            @relation(fields: [postGroupId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([lockedAt])
  @@map("publication_jobs")
}

model PublicationHistory {
  id               String              @id @default(uuid())
  postId           String              @map("post_id")
  groupId          String              @map("group_id")
  userId           String              @map("user_id")
  postGroupId      String              @map("post_group_id")
  publicationJobId String?             @map("publication_job_id")
  publishedAt      DateTime            @map("published_at")
  externalPostId   String?             @map("external_post_id")
  externalPostUrl  String?             @map("external_post_url")
  screenshotUrl    String?             @map("screenshot_url")
  status           PublicationStatus
  errorMessage     String?             @map("error_message")
  createdAt        DateTime            @default(now()) @map("created_at")
  group            Group               @relation(fields: [groupId], references: [id])
  postGroup        PostGroup           @relation(fields: [postGroupId], references: [id])
  post             Post                @relation(fields: [postId], references: [id])
  publicationJob   PublicationJob?     @relation(fields: [publicationJobId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  metrics          PublicationMetric[]

  @@index([postId])
  @@index([groupId])
  @@index([userId])
  @@index([publishedAt])
  @@map("publication_history")
}

model PublicationMetric {
  id                   String             @id @default(uuid())
  publicationHistoryId String             @map("publication_history_id")
  likesCount           Int                @default(0) @map("likes_count")
  commentsCount        Int                @default(0) @map("comments_count")
  sharesCount          Int                @default(0) @map("shares_count")
  reachCount           Int                @default(0) @map("reach_count")
  impressionsCount     Int                @default(0) @map("impressions_count")
  collectedAt          DateTime           @default(now()) @map("collected_at")
  publicationHistory   PublicationHistory @relation(fields: [publicationHistoryId], references: [id], onDelete: Cascade)

  @@index([publicationHistoryId])
  @@map("publication_metrics")
}

model PostTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  name      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  post      Post?    @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("post_templates")
}

model PostVersion {
  id            String   @id @default(uuid())
  postId        String   @map("post_id")
  content       String
  versionNumber Int      @map("version_number")
  createdAt     DateTime @default(now()) @map("created_at")
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, versionNumber])
  @@map("post_versions")
}

model Plan {
  id            String         @id @default(uuid())
  name          String         @unique
  priceMonthly  Decimal        @map("price_monthly") @db.Decimal(10, 2)
  maxPosts      Int?           @map("max_posts")
  maxGroups     Int?           @map("max_groups")
  aiCredits     Int?           @map("ai_credits")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  planId      String    @map("plan_id")
  status      String
  startedAt   DateTime  @map("started_at")
  endsAt      DateTime? @map("ends_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  plan        Plan      @relation(fields: [planId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model UsageLimit {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  month            DateTime
  postsCreated     Int      @default(0) @map("posts_created")
  publicationsSent Int      @default(0) @map("publications_sent")
  aiCreditsUsed    Int      @default(0) @map("ai_credits_used")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("usage_limits")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model GroupSyncHistory {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  connectedAccountId String?           @map("connected_account_id")
  syncedAt           DateTime          @default(now()) @map("synced_at")
  groupsFound        Int               @default(0) @map("groups_found")
  groupsAdded        Int               @default(0) @map("groups_added")
  groupsRemoved      Int               @default(0) @map("groups_removed")
  status             String
  errorMessage       String?           @map("error_message")
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([syncedAt])
  @@map("group_sync_history")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ConnectedAccountProvider {
  FACEBOOK
  INSTAGRAM
}

enum ConnectedAccountStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum PostStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum FrequencyType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum IntervalUnit {
  MINUTES
  HOURS
  DAYS
  WEEKS
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum PublicationStatus {
  SUCCESS
  FAILED
}

enum CampaignType {
  ONE_TIME
  RECURRING
  SCHEDULED
}

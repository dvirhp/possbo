generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ConnectedAccountProvider {
  FACEBOOK
  INSTAGRAM
}

enum ConnectedAccountStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum PostStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum FrequencyType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum IntervalUnit {
  MINUTES
  HOURS
  DAYS
  WEEKS
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum PublicationStatus {
  SUCCESS
  FAILED
}

enum CampaignType {
  ONE_TIME
  RECURRING
  SCHEDULED
}

// ─── USERS ──────────────────────────────────────────────

model User {
  id                       String     @id @default(uuid())
  email                    String?    @unique
  username                 String?    @unique
  idNumber                 String?    @unique @map("id_number")
  passwordHash             String?    @map("password_hash")
  name                     String?
  firstName                String?    @map("first_name")
  lastName                 String?    @map("last_name")
  phone                    String?
  profilePicture           String?    @map("profile_picture_url")
  profileImage             String?    @map("profile_image")
  facebookId               String?    @unique @map("facebook_id")
  facebookAccessToken      String?    @map("facebook_access_token")
  facebookAppId            String?    @map("facebook_app_id")
  facebookAppSecret        String?    @map("facebook_app_secret")
  facebookOauthId          String?    @unique @map("facebook_oauth_id")
  facebookStorageState     String?    @map("facebook_storage_state")
  fbSessionValid           Boolean    @default(false) @map("fb_session_valid")
  googleId                 String?    @unique @map("google_id")
  githubId                 String?    @unique @map("github_id")
  linkedinId               String?    @unique @map("linkedin_id")
  appleId                  String?    @unique @map("apple_id")
  avatarUrl                String?    @map("avatar_url")
  gender                   String?
  status                   UserStatus @default(ACTIVE)
  refreshToken             String?    @map("refresh_token")
  whatsappNumber           String?    @map("whatsapp_number")
  whatsappMessage          String?    @map("whatsapp_message")
  whatsappSessionConnected Boolean    @default(false) @map("whatsapp_session_connected")
  whatsappSessionPhone     String?    @map("whatsapp_session_phone")
  whatsappBotPhone         String?    @unique @map("whatsapp_bot_phone")
  notificationSettings     Json?      @map("notification_settings")
  emailVerifiedAt          DateTime?  @map("email_verified_at")
  lastLoginAt              DateTime?  @map("last_login_at")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")
  deletedAt                DateTime?  @map("deleted_at")

  facebookGroups     FacebookGroup[]
  whatsappContacts   WhatsAppContact[]
  whatsappBroadcasts WhatsAppBroadcastList[]
  connectedAccounts  ConnectedAccount[]
  sessions           UserSession[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  userGroups         UserGroup[]
  posts              Post[]
  postGroups         PostGroup[]
  postTemplates      PostTemplate[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  groupSyncs         GroupSyncHistory[]
  publicationHistory PublicationHistory[]
  subscriptions      Subscription[]
  payments           Payment[]
  usageLimits        UsageLimit[]
  dailyExposure      DailyExposure[]
  dailyStats         DailyStats[]
  whatsappSession    WhatsAppSession?
  botConversations   WhatsAppBotConversation[]
  botOtps            WhatsAppBotOtp[]

  @@map("users")
}

model PendingRegistration {
  id           String   @id @default(uuid())
  email        String   @unique
  codeHash     String   @map("code_hash")
  passwordHash String   @map("password_hash")
  name         String?
  gender       String?
  phone        String?
  idNumber     String?  @map("id_number")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("pending_registrations")
}

// ─── AUTH ────────────────────────────────────────────────

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── CONNECTED ACCOUNTS ─────────────────────────────────

model ConnectedAccount {
  id                    String                   @id @default(uuid())
  userId                String                   @map("user_id")
  provider              ConnectedAccountProvider
  providerUserId        String                   @map("provider_user_id")
  providerUserName      String?                  @map("provider_user_name")
  accessTokenEncrypted  String                   @map("access_token_encrypted")
  refreshTokenEncrypted String?                  @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?                @map("token_expires_at")
  storageStatePath      String?                  @map("storage_state_path")
  status                ConnectedAccountStatus   @default(ACTIVE)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userGroups UserGroup[]
  groupSyncs GroupSyncHistory[]

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("connected_accounts")
}

// ─── GROUPS ─────────────────────────────────────────────

model FacebookGroup {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  groupId     String   @map("group_id")
  groupName   String   @map("group_name")
  groupImage  String?  @map("group_image")
  screenshot  String?
  memberCount Int?     @map("member_count")
  privacyType String?  @map("privacy_type")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("facebook_groups")
}

model WhatsAppContact {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  waId             String   @map("wa_id") // JID (e.g. 972501234567@s.whatsapp.net or 123456@g.us)
  name             String?
  pushName         String?  @map("push_name")
  phone            String?
  isGroup          Boolean  @default(false) @map("is_group")
  participantCount Int?     @map("participant_count")
  profilePicUrl    String?  @map("profile_pic_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, waId])
  @@index([userId])
  @@map("whatsapp_contacts")
}

model WhatsAppBroadcastList {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  members   Json     @default("[]") // Array of { phone: string, name?: string }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_broadcast_lists")
}

model WhatsAppSession {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  stateEncrypted String   @map("state_encrypted")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

model WhatsAppBotConversation {
  id        String   @id @default(uuid())
  phone     String
  userId    String?  @map("user_id")
  state     Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([phone])
  @@index([userId])
  @@index([expiresAt])
  @@map("whatsapp_bot_conversations")
}

model WhatsAppBotOtp {
  id        String   @id @default(uuid())
  phone     String   @unique
  userId    String   @map("user_id")
  email     String?
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("whatsapp_bot_otps")
}

model Group {
  id              String   @id @default(uuid())
  externalGroupId String?  @unique @map("external_group_id")
  name            String
  pictureUrl      String?  @map("picture_url")
  url             String?
  privacyType     String?  @map("privacy_type")
  memberCount     Int?     @map("member_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userGroups         UserGroup[]
  postGroups         PostGroup[]
  publicationHistory PublicationHistory[]

  @@map("groups")
}

model UserGroup {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  groupId            String    @map("group_id")
  connectedAccountId String?   @map("connected_account_id")
  role               String?
  canPost            Boolean   @default(true) @map("can_post")
  joinedAt           DateTime? @map("joined_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_groups")
}

// ─── POSTS ──────────────────────────────────────────────

model Post {
  id                   String       @id @default(uuid())
  userId               String       @map("user_id")
  title                String?
  content              String
  status               PostStatus   @default(DRAFT)
  isAnonymous          Boolean      @default(false) @map("is_anonymous")
  location             String?
  campaignType         CampaignType @default(ONE_TIME) @map("campaign_type")
  recurringDays        Int[]        @default([]) @map("recurring_days")
  scheduledDates       DateTime[]   @default([]) @map("scheduled_dates")
  recurringTime        String?      @map("recurring_time")
  recurringTimes       String[]     @default([]) @map("recurring_times")
  recurringStart       DateTime?    @map("recurring_start")
  recurringEnd         DateTime?    @map("recurring_end")
  dayTimes             Json?        @map("day_times")
  isPaused             Boolean      @default(false) @map("is_paused")
  publishToProfile     Boolean      @default(false) @map("publish_to_profile")
  instagramEnabled     Boolean      @default(false) @map("instagram_enabled")
  instagramPublishType String?      @map("instagram_publish_type") // FEED | STORY | REEL
  storyMediaMode       String?      @map("story_media_mode") // first | all | pick
  storyPickedIndex     Int?         @map("story_picked_index")
  storyCaptions        Json?        @map("story_captions") // per-image captions array
  whatsappEnabled      Boolean      @default(false) @map("whatsapp_enabled")
  whatsappTargets      Json?        @map("whatsapp_targets") // array of { id, type: 'group'|'broadcast', name }
  templateName         String?      @map("template_name")
  draftData            Json?        @map("draft_data")
  imageUrl             String?      @map("image_url")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  media              PostMedia[]
  postGroups         PostGroup[]
  versions           PostVersion[]
  publicationHistory PublicationHistory[]
  publicationJobs    PublicationJob[]
  schedules          PostGroupSchedule[]

  @@index([userId])
  @@index([status])
  @@map("posts")
}

model PostMedia {
  id         String    @id @default(uuid())
  postId     String    @map("post_id")
  mediaType  MediaType @map("media_type")
  url        String
  storageKey String?   @map("storage_key")
  orderIndex Int       @default(0) @map("order_index")
  altText    String?   @map("alt_text")
  igType     String?   @map("ig_type") // null=global, FEED/STORY/REEL=type-specific
  createdAt  DateTime  @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostGroup {
  id              String   @id @default(uuid())
  postId          String   @map("post_id")
  groupId         String   @map("group_id")
  userId          String   @map("user_id")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  priorityEnabled Boolean  @default(false) @map("priority_enabled")
  priorityRank    Int?     @map("priority_rank")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  schedules          PostGroupSchedule[]
  jobs               PublicationJob[]
  publicationHistory PublicationHistory[]

  @@unique([postId, groupId])
  @@index([userId])
  @@map("post_groups")
}

// ─── SCHEDULING ─────────────────────────────────────────

model PostGroupSchedule {
  id            String        @id @default(uuid())
  postGroupId   String?       @map("post_group_id")
  postId        String?       @map("post_id")
  targetType    String        @default("GROUP") @map("target_type") // GROUP | PROFILE | INSTAGRAM | WHATSAPP
  platform      String        @default("FACEBOOK") @map("platform") // FACEBOOK | INSTAGRAM | WHATSAPP
  igPublishType String?       @map("ig_publish_type") // FEED | STORY | REEL
  frequencyType FrequencyType @map("frequency_type")
  intervalValue Int?          @map("interval_value")
  intervalUnit  IntervalUnit? @map("interval_unit")
  startAt       DateTime?     @map("start_at")
  endAt         DateTime?     @map("end_at")
  nextRunAt     DateTime?     @map("next_run_at")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  postGroup PostGroup? @relation(fields: [postGroupId], references: [id], onDelete: Cascade)
  post      Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postGroupId])
  @@index([postId])
  @@index([nextRunAt, isActive])
  @@map("post_group_schedules")
}

model PublicationJob {
  id            String    @id @default(uuid())
  postGroupId   String?   @map("post_group_id")
  postId        String?   @map("post_id")
  targetType    String    @default("GROUP") @map("target_type") // GROUP | PROFILE | INSTAGRAM | WHATSAPP
  platform      String    @default("FACEBOOK") @map("platform") // FACEBOOK | INSTAGRAM | WHATSAPP
  igPublishType String?   @map("ig_publish_type") // FEED | STORY | REEL — which IG type this job handles
  scheduledAt   DateTime  @map("scheduled_at")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  lastError     String?   @map("last_error")
  lockedAt      DateTime? @map("locked_at")
  lockedBy      String?   @map("locked_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  postGroup    PostGroup?           @relation(fields: [postGroupId], references: [id], onDelete: Cascade)
  post         Post?                @relation(fields: [postId], references: [id], onDelete: Cascade)
  publications PublicationHistory[]

  @@index([status, scheduledAt])
  @@index([lockedAt])
  @@map("publication_jobs")
}

// ─── PUBLICATION HISTORY & METRICS ──────────────────────

model PublicationHistory {
  id               String            @id @default(uuid())
  postId           String            @map("post_id")
  groupId          String?           @map("group_id")
  userId           String            @map("user_id")
  postGroupId      String?           @map("post_group_id")
  publicationJobId String?           @map("publication_job_id")
  targetType       String            @default("GROUP") @map("target_type") // GROUP | PROFILE | INSTAGRAM | WHATSAPP
  platform         String            @default("FACEBOOK") @map("platform") // FACEBOOK | INSTAGRAM | WHATSAPP
  publishedAt      DateTime          @map("published_at")
  externalPostId   String?           @map("external_post_id")
  externalPostUrl  String?           @map("external_post_url")
  screenshotUrl    String?           @map("screenshot_url")
  status           PublicationStatus
  errorMessage     String?           @map("error_message")
  createdAt        DateTime          @default(now()) @map("created_at")

  post           Post                @relation(fields: [postId], references: [id])
  group          Group?              @relation(fields: [groupId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  postGroup      PostGroup?          @relation(fields: [postGroupId], references: [id])
  publicationJob PublicationJob?     @relation(fields: [publicationJobId], references: [id])
  metrics        PublicationMetric[]

  @@index([postId])
  @@index([groupId])
  @@index([userId])
  @@index([publishedAt])
  @@index([userId, status, publishedAt])
  @@map("publication_history")
}

model PublicationMetric {
  id                     String   @id @default(uuid())
  publicationHistoryId   String   @map("publication_history_id")
  likesCount             Int      @default(0) @map("likes_count")
  commentsCount          Int      @default(0) @map("comments_count")
  sharesCount            Int      @default(0) @map("shares_count")
  reachCount             Int      @default(0) @map("reach_count")
  impressionsCount       Int      @default(0) @map("impressions_count")
  viewsCount             Int      @default(0) @map("views_count")
  savesCount             Int      @default(0) @map("saves_count")
  repliesCount           Int      @default(0) @map("replies_count")
  totalInteractionsCount Int      @default(0) @map("total_interactions_count")
  collectedAt            DateTime @default(now()) @map("collected_at")

  publicationHistory PublicationHistory @relation(fields: [publicationHistoryId], references: [id], onDelete: Cascade)

  @@index([publicationHistoryId])
  @@index([publicationHistoryId, collectedAt])
  @@map("publication_metrics")
}

// ─── TEMPLATES ──────────────────────────────────────────

model PostTemplate {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  content        String
  campaignTitle  String?  @map("campaign_title")
  isAnonymous    Boolean  @default(false) @map("is_anonymous")
  location       String?
  whatsappText   String?  @map("whatsapp_text")
  scheduleMode   String?  @map("schedule_mode")
  scheduledDate  String?  @map("scheduled_date")
  recurringDays  Int[]    @default([]) @map("recurring_days")
  recurringTimes String[] @default([]) @map("recurring_times")
  dayTimes       Json?    @map("day_times")
  groupIds       String[] @default([]) @map("group_ids")
  imageUrls      String[] @default([]) @map("image_urls")
  usageCount     Int      @default(0) @map("usage_count")

  // Profile publishing
  publishToProfile          Boolean @default(false) @map("publish_to_profile")
  profileScheduleMode       String? @map("profile_schedule_mode")
  profileScheduleDate       String? @map("profile_schedule_date")
  profileScheduleTime       String? @map("profile_schedule_time")
  profileRecurringDays      Int[]   @default([]) @map("profile_recurring_days")
  profileDayTimes           Json?   @map("profile_day_times")
  profileRecurringStartDate String? @map("profile_recurring_start_date")
  profileRecurringEndDate   String? @map("profile_recurring_end_date")

  // Instagram publishing
  instagramEnabled      Boolean  @default(false) @map("instagram_enabled")
  instagramPublishTypes String[] @default([]) @map("instagram_publish_types")
  storyMediaMode        String?  @map("story_media_mode")
  storyPickedIndex      Int?     @map("story_picked_index")
  igScheduleMode        String?  @map("ig_schedule_mode")

  // WhatsApp publishing
  whatsappEnabled      Boolean @default(false) @map("whatsapp_enabled")
  whatsappTargets      Json?   @map("whatsapp_targets") // array of { id, type, name }
  waScheduleMode       String? @map("wa_schedule_mode")
  waScheduleDate       String? @map("wa_schedule_date")
  waScheduleTime       String? @map("wa_schedule_time")
  waRecurringDays      Int[]   @default([]) @map("wa_recurring_days")
  waDayTimes           Json?   @map("wa_day_times")
  waRecurringStartDate String? @map("wa_recurring_start_date")
  waRecurringEndDate   String? @map("wa_recurring_end_date")
  igScheduleDate       String? @map("ig_schedule_date")
  igScheduleTime       String? @map("ig_schedule_time")
  igRecurringDays      Int[]   @default([]) @map("ig_recurring_days")
  igDayTimes           Json?   @map("ig_day_times")
  igRecurringStartDate String? @map("ig_recurring_start_date")
  igRecurringEndDate   String? @map("ig_recurring_end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("post_templates")
}

model PostVersion {
  id            String   @id @default(uuid())
  postId        String   @map("post_id")
  content       String
  versionNumber Int      @map("version_number")
  createdAt     DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, versionNumber])
  @@map("post_versions")
}

// ─── BILLING ────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(10, 2)
  maxPosts     Int?     @map("max_posts")
  maxGroups    Int?     @map("max_groups")
  aiCredits    Int?     @map("ai_credits")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  planId                String    @map("plan_id")
  status                String
  startedAt             DateTime  @map("started_at")
  endsAt                DateTime? @map("ends_at")
  cancelledAt           DateTime? @map("cancelled_at")
  gatewayCustomerId     String?   @map("gateway_customer_id")
  gatewaySubscriptionId String?   @map("gateway_subscription_id")
  paymentToken          String?   @map("payment_token")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  subscriptionId       String   @map("subscription_id")
  amount               Decimal  @db.Decimal(10, 2)
  currency             String   @default("ILS")
  status               String
  periodStart          DateTime @map("period_start")
  periodEnd            DateTime @map("period_end")
  isProrated           Boolean  @default(false) @map("is_prorated")
  gatewayTransactionId String?  @map("gateway_transaction_id")
  failureReason        String?  @map("failure_reason")
  createdAt            DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@map("payments")
}

model UsageLimit {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  month            DateTime
  postsCreated     Int      @default(0) @map("posts_created")
  publicationsSent Int      @default(0) @map("publications_sent")
  aiCreditsUsed    Int      @default(0) @map("ai_credits_used")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("usage_limits")
}

// ─── NOTIFICATIONS & AUDIT ──────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model GroupSyncHistory {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  connectedAccountId String?  @map("connected_account_id")
  syncedAt           DateTime @default(now()) @map("synced_at")
  groupsFound        Int      @default(0) @map("groups_found")
  groupsAdded        Int      @default(0) @map("groups_added")
  groupsRemoved      Int      @default(0) @map("groups_removed")
  status             String
  errorMessage       String?  @map("error_message")

  user             User              @relation(fields: [userId], references: [id])
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])

  @@index([userId])
  @@index([syncedAt])
  @@map("group_sync_history")
}

// ─── EXPOSURE TRACKING ──────────────────────────────────

model DailyExposure {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           DateTime @db.Date
  exposureCount  Int      @default(0) @map("exposure_count")
  postsPublished Int      @default(0) @map("posts_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_exposure")
}

model DailyStats {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           DateTime @db.Date
  groupsCount    Int      @default(0) @map("groups_count")
  postsCount     Int      @default(0) @map("posts_count")
  scheduledCount Int      @default(0) @map("scheduled_count")
  publishedCount Int      @default(0) @map("published_count")
  exposureCount  Int      @default(0) @map("exposure_count")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_stats")
}
